cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED TTS_MODELS_DIR)
    set(TTS_MODELS_DIR "${CMAKE_CURRENT_LIST_DIR}/models")
endif()
if(NOT DEFINED TTS_EXPORT_PYTHON OR TTS_EXPORT_PYTHON STREQUAL "")
    set(TTS_EXPORT_PYTHON python3)
endif()

function(download_verified url sha256 destination)
    if(EXISTS "${destination}")
        file(SHA256 "${destination}" existing_hash)
        if(existing_hash STREQUAL sha256)
            message(STATUS "Using verified ${destination}")
            return()
        endif()
    endif()

    set(partial "${destination}.part")
    message(STATUS "Downloading ${url}")
    file(DOWNLOAD "${url}" "${partial}" TLS_VERIFY ON TIMEOUT 900 INACTIVITY_TIMEOUT 60 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        list(GET status 1 description)
        file(REMOVE "${partial}")
        message(FATAL_ERROR "TTS model download failed: ${description}")
    endif()
    file(SHA256 "${partial}" downloaded_hash)
    if(NOT downloaded_hash STREQUAL sha256)
        file(REMOVE "${partial}")
        message(FATAL_ERROR "SHA-256 mismatch for ${url}")
    endif()
    file(RENAME "${partial}" "${destination}")
endfunction()

file(MAKE_DIRECTORY "${TTS_MODELS_DIR}")
file(LOCK "${TTS_MODELS_DIR}/.download.lock" GUARD PROCESS TIMEOUT 120)
set(model "${TTS_MODELS_DIR}/silero_ru.onnx")

if(TTS_MODEL_URL OR TTS_MODEL_SHA256)
    string(LENGTH "${TTS_MODEL_SHA256}" hash_length)
    if(NOT TTS_MODEL_URL OR NOT hash_length EQUAL 64 OR NOT TTS_MODEL_SHA256 MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "Set both TTS_MODEL_URL and its 64-digit TTS_MODEL_SHA256.")
    endif()
    string(TOLOWER "${TTS_MODEL_SHA256}" model_sha256)
    download_verified("${TTS_MODEL_URL}" "${model_sha256}" "${model}")
    return()
endif()

# Official v4_ru is a PyTorch package. Verify the archive before loading it.
set(checkpoint_sha256 896ab96347d5bd781ab97959d4fd6885620e5aab52405d3445626eb7c1414b00)
set(checkpoint "${TTS_MODELS_DIR}/v4_ru.pt")
set(exporter "${CMAKE_CURRENT_LIST_DIR}/ExportSilero.py")
set(stamp "${TTS_MODELS_DIR}/silero_ru.onnx.sha256")
file(SHA256 "${exporter}" exporter_sha256)
set(export_version "${checkpoint_sha256}\n${exporter_sha256}\n")

if(EXISTS "${model}" AND EXISTS "${stamp}")
    file(SHA256 "${model}" model_hash)
    file(READ "${stamp}" previous_export)
    if(previous_export STREQUAL "${export_version}${model_hash}\n")
        message(STATUS "Using verified ${model}")
        return()
    endif()
endif()

download_verified("https://models.silero.ai/models/tts/ru/v4_ru.pt" "${checkpoint_sha256}" "${checkpoint}")
message(STATUS "Exporting Silero v4_ru to ${model}")
execute_process(COMMAND "${TTS_EXPORT_PYTHON}" "${exporter}" "${checkpoint}" "${model}.part"
    RESULT_VARIABLE export_status)
if(NOT export_status STREQUAL "0")
    file(REMOVE "${model}.part")
    message(FATAL_ERROR "Silero ONNX export failed. See the TTS section of README.md for the Python export environment.")
endif()
file(SHA256 "${model}.part" model_hash)
file(WRITE "${stamp}.part" "${export_version}${model_hash}\n")
file(RENAME "${model}.part" "${model}")
file(RENAME "${stamp}.part" "${stamp}")
